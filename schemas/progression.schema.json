{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/n05a-design/steps/blob/main/schemas/progression.schema.json",
  "title": "STEPS chord progression v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "notation",
    "bars"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "key": {
      "type": "string"
    },
    "mode": {
      "type": "string"
    },
    "notation": {
      "enum": [
        "german",
        "international"
      ]
    },
    "time_signature": {
      "type": "string",
      "pattern": "^[0-9]+/[0-9]+$"
    },
    "tempo_bpm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "style": {
      "type": "string"
    },
    "bars": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "chords"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 1
          },
          "chords": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "analysis": {
            "type": "string"
          },
          "voicing_notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
