{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/n05a-design/steps/blob/main/schemas/analysis.schema.json",
  "title": "STEPS harmony analysis v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "progression_id",
    "interpretations"
  ],
  "properties": {
    "progression_id": {
      "type": "string"
    },
    "interpretations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "framework",
          "explanation"
        ],
        "properties": {
          "framework": {
            "enum": [
              "functional",
              "modal",
              "jazz",
              "popular",
              "transformational",
              "other"
            ]
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          },
          "roman_numerals": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
