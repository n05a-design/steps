{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/n05a-design/steps/blob/main/schemas/concept.schema.json",
  "title": "STEPS concept v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "term",
    "definition",
    "source_ids"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "term": {
      "type": "string",
      "minLength": 1
    },
    "definition": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string"
    },
    "synonyms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "draft",
        "reviewed",
        "verified"
      ]
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
