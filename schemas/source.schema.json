{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/n05a-design/steps/blob/main/schemas/source.schema.json",
  "title": "STEPS source metadata v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "rights_status",
    "kind"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "book",
        "article",
        "paper",
        "website",
        "media",
        "dataset",
        "internal_note",
        "code",
        "other"
      ]
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "retrieved_at": {
      "type": "string",
      "format": "date"
    },
    "license": {
      "type": [
        "string",
        "null"
      ]
    },
    "rights_status": {
      "enum": [
        "approved",
        "review_required",
        "restricted_local",
        "rejected"
      ]
    },
    "usage_notes": {
      "type": "string"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
