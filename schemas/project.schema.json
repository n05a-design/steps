{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/n05a-design/steps/blob/main/schemas/project.schema.json",
  "title": "STEPS Project File Schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "app_version",
    "project_id",
    "title",
    "time_settings",
    "tracks"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "app_version": {
      "type": "string"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object",
      "properties": {
        "created_at": { "type": "string" },
        "modified_at": { "type": "string" },
        "author": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "notation_convention": {
      "enum": ["INT", "DE"]
    },
    "time_settings": {
      "type": "object",
      "required": ["ppq", "time_signature", "tempo_bpm"],
      "properties": {
        "ppq": {
          "type": "integer",
          "minimum": 96,
          "maximum": 1920
        },
        "time_signature": {
          "type": "object",
          "required": ["numerator", "denominator"],
          "properties": {
            "numerator": { "type": "integer", "minimum": 1, "maximum": 32 },
            "denominator": { "type": "integer", "enum": [1, 2, 4, 8, 16, 32] }
          }
        },
        "tempo_bpm": {
          "type": "number",
          "minimum": 20.0,
          "maximum": 400.0
        },
        "tempo_points": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["start_tick", "bpm"],
            "properties": {
              "start_tick": { "type": "integer", "minimum": 0 },
              "bpm": { "type": "number", "minimum": 20.0, "maximum": 400.0 }
            }
          }
        }
      }
    },
    "tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["track_id", "track_type", "name", "events"],
        "properties": {
          "track_id": { "type": "string" },
          "track_type": { "enum": ["CHORDS", "MELODY", "DRUMS", "BASS", "ANNOTATIONS"] },
          "name": { "type": "string" },
          "channel": { "type": "integer", "minimum": 0, "maximum": 15 },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["start_tick", "duration_ticks", "payload"],
              "properties": {
                "event_id": { "type": "string" },
                "start_tick": { "type": "integer", "minimum": 0 },
                "duration_ticks": { "type": "integer", "minimum": 1 },
                "payload": {}
              }
            }
          }
        }
      }
    }
  }
}
