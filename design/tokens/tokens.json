{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "version": "1.0.0",
  "metadata": {
    "project": "STEPS",
    "description": "Design Tokens für die STEPS Desktop-Applikation (ADR-001 / Prompt 06)",
    "wcag_compliance": "WCAG 2.1 AA (4.5:1 Kontrast)"
  },
  "themes": {
    "dark": {
      "bg_window": "#121319",
      "bg_surface": "#1E222C",
      "bg_surface_hover": "#282D3A",
      "bg_active": "#323848",
      "border": "#383C49",
      "border_focus": "#60A5FA",
      "text_primary": "#F3F1ED",
      "text_secondary": "#B7BAC4",
      "text_muted": "#7A7F8D",
      "text_inverted": "#121319",
      "harmonic_tonic": "#60A5FA",
      "harmonic_subdominant": "#34D399",
      "harmonic_dominant": "#F87171",
      "harmonic_altered": "#A78BFA",
      "harmonic_minor": "#22D3EE"
    },
    "light": {
      "bg_window": "#F8F9FA",
      "bg_surface": "#FFFFFF",
      "bg_surface_hover": "#EDF2F7",
      "bg_active": "#E2E8F0",
      "border": "#CBD5E1",
      "border_focus": "#2563EB",
      "text_primary": "#0F172A",
      "text_secondary": "#334155",
      "text_muted": "#64748B",
      "text_inverted": "#FFFFFF",
      "harmonic_tonic": "#2563EB",
      "harmonic_subdominant": "#059669",
      "harmonic_dominant": "#DC2626",
      "harmonic_altered": "#7C3AED",
      "harmonic_minor": "#0891B2"
    }
  },
  "typography": {
    "font_family_sans": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
    "font_family_mono": "'SF Mono', Menlo, Consolas, Monaco, monospace",
    "sizes": {
      "xs": 11,
      "sm": 12,
      "md": 14,
      "lg": 16,
      "xl": 20,
      "title": 24
    }
  },
  "spacing": {
    "xs": 4,
    "sm": 8,
    "md": 16,
    "lg": 24,
    "xl": 32,
    "radius_sm": 4,
    "radius_md": 8
  }
}
