{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chord Progression Result",
  "type": "object",
  "required": [
    "key",
    "notation",
    "time_signature",
    "bars"
  ],
  "properties": {
    "key": {
      "type": "string"
    },
    "notation": {
      "type": "string",
      "enum": [
        "german",
        "international"
      ]
    },
    "style": {
      "type": "string"
    },
    "tempo_bpm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "time_signature": {
      "type": "string"
    },
    "bars": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "index",
          "chords"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 1
          },
          "chords": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "analysis": {
            "type": "string"
          },
          "voicing_notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
