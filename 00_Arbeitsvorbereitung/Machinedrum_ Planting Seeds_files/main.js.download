xt.innerHTML=str;return txt.value}function slugify(str){return str.toLowerCase().replace(/\s+/g,"-").replace(/[^a-z0-9-]/g,"")}function addCardEventListeners(item){item.addEventListener("click",()=>openModal(item,true));item.addEventListener("mouseenter",()=>{if(!isTouchScreen){var title=item.dataset.modalTitle;var author=item.dataset.modalAuthor;carouselHoverName.textContent=title;carouselHoverAuthor.textContent=decodeHtmlEntities(window.abltranslations.authorBy)+" "+author;carouselHoverInfo.classList.add("visible");cursorCta.classList.add("visible");track.classList.add("hovered")}});item.addEventListener("mouseleave",()=>{if(!isTouchScreen){carouselHoverInfo.classList.remove("visible");cursorCta.classList.remove("visible");track.classList.remove("hovered")}});item.addEventListener("mousemove",e=>{if(!isTouchScreen){cursorCta.style.left=e.clientX+2+"px";cursorCta.style.top=e.clientY+18+"px"}})}cards.forEach(card=>addCardEventListeners(card));cards.forEach(card=>{const clone=card.cloneNode(true);addCardEventListeners(clone);track.appendChild(clone)});cards.forEach(card=>{const clone=card.cloneNode(true);addCardEventListeners(clone);track.appendChild(clone)});const overlay=document.getElementById("overlay");let current=0;function openModal(eleClicked,pushState){current=parseInt(eleClicked.dataset.index);renderModal(eleClicked);overlay.classList.add("open");track.classList.add("paused");const slug=slugify(eleClicked.dataset.modalTitle);if(pushState){history.pushState({extSlug:slug},"","#"+slug)}else{history.replaceState({extSlug:slug},"","#"+slug)}}function closeModal(updateHistory){track.classList.remove("paused");overlay.classList.remove("open");if(updateHistory!==false){history.replaceState(null,"",location.pathname+location.search)}}function navigate(dir){current=((current+dir)%cards.length+cards.length)%cards.length;renderModal(cards[current]);const slug=slugify(cards[current].dataset.modalTitle);history.replaceState({extSlug:slug},"","#"+slug)}function renderMod