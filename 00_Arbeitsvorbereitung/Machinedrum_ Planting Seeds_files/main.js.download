setupMediaIntroHeading(){const component=document.querySelector(".usn_cmp_ablmediaintro");if(!component)return;const heading=component.querySelector(".heading.main .mediaIntro-title-right");if(!heading)return;const headingRect=heading.getBoundingClientRect();let topLimit=.85;let naturalTop=headingRect.top+window.scrollY;let floatingLeft=headingRect.left;let floatingWidth=headingRect.width;let twoThirds=window.innerHeight*topLimit;const placeholder=document.createElement("div");placeholder.style.height=heading.offsetHeight+"px";placeholder.style.display="none";heading.parentNode.insertBefore(placeholder,heading);function update(){if(window.scrollY>=naturalTop-twoThirds){placeholder.style.display="none";heading.style.cssText=""}else{placeholder.style.display="";heading.style.position="fixed";heading.style.top=twoThirds+"px";heading.style.left=floatingLeft+"px";heading.style.width=floatingWidth+"px";heading.style.zIndex="100"}}window.addEventListener("scroll",update,{passive:true});window.addEventListener("resize",()=>{placeholder.style.display="none";heading.style.cssText="";const rect=heading.getBoundingClientRect();naturalTop=rect.top+window.scrollY;floatingLeft=rect.left;floatingWidth=rect.width;placeholder.style.height=heading.offsetHeight+"px";twoThirds=window.innerHeight*topLimit;update()},{passive:true});update()}$(function(){function stopVideo($pane){if(!$pane||!$pane.length)return;var $iframe=$pane.find('iframe[src*="youtube"]');if(!$iframe.length)return;var src=$iframe.attr("src");var hashIndex=src.indexOf("#");var hash=hashIndex===-1?"":src.slice(hashIndex);var base=hashIndex===-1?src:src.slice(0,hashIndex);var qIndex=base.indexOf("?");var path=qIndex===-1?base:base.slice(0,qIndex);var query=qIndex===-1?"":base.slice(qIndex+1);var params=query.length?query.split("&").filter(function(pair){var key=pair.split("=")[0];return key!=="autoplay"&&key!=="_stop"}):[];params.push("_stop="+Date.now());$iframe.attr("src",path+"?"+params.join("&")+hash)}$(".repeatable.tabbed").each(function(){var activeId=$(this).find(".nav-link.active").attr("id")||null;$(this).data("activeTabId",activeId)});function switchTo($repeatable,newTabId){var currentId=$repeatable.data("activeTabId");if(currentId===newTabId)return;var $currentLink=$repeatable.find("#"+currentId);var paneSelector=$currentLink.attr("href");if(paneSelector)stopVideo($repeatable.find(paneSelector));$repeatable.data("activeTabId",newTabId)}$(document).on("click",".repeatable.tabbed .nav-link",function(){var $repeatable=$(this).closest(".repeatable.tabbed");switchTo($repeatable,$(this).attr("id"))});$(document).on("click",".abl-dropdown-option",function(){var $repeatable=$(this).closest(".repeatable.tabbed");switchTo($repeatable,$(this).data("value"))})});(function(){"use strict";const SLIDE_DUR=1800;const LTR_LEAD=45;const LTR_GAP=160;const reducedMotion=window.matchMedia("(prefers-reduced-motion: reduce)").matches;const heroText=document.getElementsByClassName("hero-text")[0];const logo=document.getElementsByClassName("animating-logo")[0];if(logo===undefined){return}if(reducedMotion){document.querySelectorAll(".lp").forEach(p=>{p.style.visibility="visible"});heroText.classList.add("visible");return}setTimeout(()=>{logo.style.animation=`logoSlide ${SLIDE_DUR}ms cubic-bezier(0.25, 1, 0.5, 1) both`;let cursor=0;let lastBlock=0;["ltr-m","ltr-o","ltr-v","ltr-e"].forEach((id,li)=>{if(li>0)cursor+=LTR_GAP;const paths=document.getElementById(id).querySelectorAll(".lp");paths.forEach((path,pi)=>{const t=cursor+pi*LTR_LEAD;lastBlock=Math.max(lastBlock,t);path.style.animation=`appear 1ms linear ${t}ms both`});cursor+=(paths.length-1)*LTR_LEAD});setTimeout(()=>heroText.classList.add("visible"),lastBlock+400)},700)})();$(document).ready(function(){setupTabbedMedia();setupPseudoStickyHeaders();setupHardwareFilter();setupExtensionsCarousel();setupMediaIntroHeading()});