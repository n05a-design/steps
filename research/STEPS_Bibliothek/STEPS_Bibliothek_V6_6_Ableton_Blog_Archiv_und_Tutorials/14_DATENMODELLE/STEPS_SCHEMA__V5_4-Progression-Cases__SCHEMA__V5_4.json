{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "STEPS V5.4 progression case",
  "type": "object",
  "required": [
    "id",
    "chord_events",
    "tempo_bpm",
    "meter",
    "review_status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "tempo_bpm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "meter": {
      "type": "string"
    },
    "chord_events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "symbol",
          "start_beats",
          "duration_beats",
          "root_pc",
          "bass_pc",
          "pcs"
        ],
        "properties": {
          "symbol": {
            "type": "string"
          },
          "start_beats": {
            "type": "number",
            "minimum": 0
          },
          "duration_beats": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "root_pc": {
            "type": "integer",
            "minimum": 0,
            "maximum": 11
          },
          "bass_pc": {
            "type": "integer",
            "minimum": 0,
            "maximum": 11
          },
          "pcs": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 11
            },
            "minItems": 3
          }
        }
      }
    },
    "review_status": {
      "type": "string"
    }
  }
}
