{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://steps.local/schema/study.v4.json",
  "type": "object",
  "required": [
    "id",
    "title",
    "tonal_center",
    "tempo_bpm",
    "meter",
    "bars_count",
    "bars",
    "origin",
    "validation_status"
  ],
  "properties": {
    "id": {
      "pattern": "^ETUDE-V4-[0-9]{3}$",
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 4
    },
    "tonal_center": {
      "type": "string"
    },
    "tempo_bpm": {
      "type": "integer",
      "minimum": 30,
      "maximum": 250
    },
    "meter": {
      "const": "4/4"
    },
    "bars_count": {
      "const": 16
    },
    "bars": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "bar",
          "chord",
          "melody",
          "bass",
          "accompaniment_midi",
          "beats"
        ],
        "properties": {
          "bar": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16
          },
          "chord": {
            "type": "string"
          },
          "beats": {
            "const": 4
          },
          "melody": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "midi",
                "start_beat",
                "duration_beats"
              ],
              "properties": {
                "midi": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 127
                },
                "start_beat": {
                  "type": "number",
                  "minimum": 0
                },
                "duration_beats": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            }
          },
          "bass": {
            "type": "array"
          },
          "accompaniment_midi": {
            "type": "array"
          }
        }
      }
    },
    "origin": {
      "const": "original_generated_exercise_not_existing_song"
    },
    "validation_status": {
      "type": "string"
    }
  }
}
